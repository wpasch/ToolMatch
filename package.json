{
  "name": "toolmatch",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "for f in js/*.js; do node --check \"$f\" || exit 1; done",
    "validate": "node scripts/validate-data.js",
    "test": "npm run check && npm run validate && node --test",
    "format": "node scripts/format-data.js",
    "og": "node scripts/build-og.js",
    "meta": "node scripts/build-meta.js",
    "stale": "node scripts/stale-report.js",
    "links": "node --max-http-header-size=65536 scripts/check-links.js"
  }
}
