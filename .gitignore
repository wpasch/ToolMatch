.DS_Store
.claude-flow/
.claude/settings.local.json

# Scratch output from browser-automation runs (screenshots, snapshots, logs)
.playwright-mcp/

# Vercel's project link and the OIDC token it writes beside it. Both are
# per-machine credentials, not configuration anyone else can use.
.vercel
.env*

# There are no runtime dependencies and no build step, so nothing here is
# meant to exist. Ignored anyway: deploying added an unused @vercel/analytics
# package unasked, and an accidental commit of one is easy to miss.
node_modules/
